{
  "manifest_version": 3,
  "name": "Explain in Generations",
  "version": "1.0.0",
  "description": "Highlight text to get AI-powered explanations customized for different generations",
  "permissions": [
    "activeTab",
    "contextMenus",
    "sidePanel",
    "storage",
    "aiLanguageModelOriginTrial"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
